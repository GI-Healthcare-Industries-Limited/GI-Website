# Safe browser configuration from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUBMISSION_HASH_SECRET=

# Optional email notification through Resend. Submissions are still stored
# and visible in /admin when these are left blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GI Healthcare Website <website@gihealthcare.co.uk>
CONTACT_NOTIFICATION_EMAIL=ash@gihealthcare.co.uk

# Used in notification links after the production domain is attached.
NEXT_PUBLIC_SITE_URL=https://www.gihealthcare.co.uk
